@page
@model IndexModel
@{
    ViewData["Title"] = "Tiago Oliveira | Front-end, React e UI/UX";
    ViewData["Description"] = "Portfólio de Tiago Henrique Penteado de Oliveira: desenvolvimento Front-end, React, React Native, UI/UX e qualidade de software.";
}

<section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="shell hero-grid">
        <div class="hero-copy" data-reveal>
            <p class="eyebrow"><span aria-hidden="true"></span> Em busca de uma oportunidade em tecnologia</p>
            <h1 id="hero-title">Transformo ideias em <em>experiências digitais</em> claras e funcionais.</h1>
            <p class="hero-intro">
                Olá, sou <strong>Tiago Henrique Penteado de Oliveira</strong>. Estudo Gestão da Tecnologia da Informação e direciono minha carreira para desenvolvimento Front-end, React, React Native e UI/UX.
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href="#projetos">Conhecer projetos <span aria-hidden="true">↓</span></a>
                <a class="button button-secondary" href="#contato">Entrar em contato <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="~/files/curriculo-tiago-oliveira.pdf" download>Baixar currículo <span aria-hidden="true">↓</span></a>
            </div>
        </div>

        <aside class="hero-card" aria-label="Resumo profissional" data-reveal>
            <div class="hero-card-top">
                <span>Perfil profissional</span>
                <span class="status-dot" title="Disponível para oportunidades"></span>
            </div>
            <div class="monogram" aria-hidden="true">
                <span>&lt;</span>TO<span>/&gt;</span>
            </div>
            <dl class="profile-list">
                <div><dt>Formação</dt><dd>Gestão de TI</dd></div>
                <div><dt>Foco</dt><dd>Front-end &amp; UI/UX</dd></div>
                <div><dt>Localização</dt><dd>Igaraçu do Tietê, SP</dd></div>
            </dl>
        </aside>
    </div>
    <div class="shell focus-strip" aria-label="Áreas de interesse">
        <span>Front-end</span><span>React</span><span>React Native</span><span>UI/UX</span><span>Qualidade de software</span>
    </div>
</section>

<section class="section about" id="sobre" aria-labelledby="about-title">
    <div class="shell split-layout">
        <div class="section-heading" data-reveal>
            <p class="section-index">01 / Sobre</p>
            <h2 id="about-title">Tecnologia com intenção, aprendizado contínuo e atenção aos detalhes.</h2>
        </div>
        <div class="prose" data-reveal>
            <p class="prose-lead">Sou estudante de Gestão da Tecnologia da Informação e construo minha trajetória unindo desenvolvimento e experiência do usuário.</p>
            <p>Tenho interesse em criar interfaces responsivas, intuitivas e bem estruturadas. Nos meus projetos, pratico HTML, CSS, JavaScript, C# e ASP.NET, enquanto amplio meus conhecimentos em React, React Native, UI/UX e qualidade de software.</p>
            <p>Busco minha oportunidade na área de tecnologia para colaborar com produtos reais, aprender com equipes experientes e evoluir profissionalmente com consistência.</p>
            <div class="principles" aria-label="Princípios de trabalho">
                <span>Acessibilidade</span><span>Responsividade</span><span>Código organizado</span><span>Segurança e LGPD</span>
            </div>
        </div>
    </div>
</section>

<section class="section projects" id="projetos" aria-labelledby="projects-title">
    <div class="shell">
        <div class="section-heading section-heading-row" data-reveal>
            <div>
                <p class="section-index">02 / Projetos</p>
                <h2 id="projects-title">Projetos que mostram minha evolução na prática.</h2>
            </div>
            <a class="text-link" href="https://github.com/TiagoHenriquee07?tab=repositories" target="_blank" rel="noopener noreferrer">Ver todos no GitHub <span aria-hidden="true">↗</span></a>
        </div>

