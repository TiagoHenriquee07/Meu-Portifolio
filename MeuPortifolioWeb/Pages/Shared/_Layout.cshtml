@inject IConfiguration Configuration
@{
    var pageTitle = ViewData["Title"] as string ?? "Tiago Oliveira | Tecnologia, gestão e processos";
    var description = ViewData["Description"] as string
        ?? "Portfólio de Tiago Henrique Penteado de Oliveira, estudante de Gestão da Tecnologia da Informação com experiência em operações, planejamento e desenvolvimento digital.";
    var configuredSiteUrl = Configuration["Portfolio:SiteUrl"];
    var siteUrl = string.IsNullOrWhiteSpace(configuredSiteUrl)
        ? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/"
        : configuredSiteUrl.TrimEnd('/') + "/";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@description" />
    <meta name="author" content="Tiago Henrique Penteado de Oliveira" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#070a12" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@siteUrl" />
    <meta property="og:site_name" content="Portfólio de Tiago Oliveira" />
    <meta property="og:image" content="@(siteUrl + "images/tiago-oliveira.jpg")" />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:image:alt" content="Retrato de Tiago Henrique Penteado de Oliveira" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@(siteUrl + "images/tiago-oliveira.jpg")" />
    <link rel="canonical" href="@siteUrl" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>document.documentElement.classList.add('js');</script>
    <title>@pageTitle</title>
</head>
<body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header" data-header>
        <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
        <div class="shell header-inner">
            <a class="brand" href="#inicio" aria-label="Ir para o início do portfólio">
                <span class="brand-copy"><strong>Tiago Oliveira</strong></span>
            </a>

            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal" data-menu-toggle>
                <span class="sr-only">Abrir menu</span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>

            <nav class="main-nav" id="menu-principal" aria-label="Navegação principal" data-menu>
                <a href="#inicio">Início</a>
                <a href="#sobre">Sobre</a>
                <a href="#experiencia">Experiência</a>
                <a href="#projetos">Projetos</a>
                <a href="#formacao">Formação</a>
                <a href="#contato">Contato</a>
                <a class="nav-resume" href="~/files/curriculo-tiago-oliveira.pdf" target="_blank" rel="noopener noreferrer">Currículo <span aria-hidden="true">↗</span></a>
            </nav>
        </div>
    </header>

    <main id="conteudo">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-inner">
            <a class="brand footer-brand" href="#inicio">
                <span class="brand-copy"><strong>Tiago Oliveira</strong></span>
            </a>
            <p>Desenvolvido por Tiago Henrique Penteado de Oliveira</p>
            <p class="copyright">© @DateTime.Now.Year</p>
        </div>
    </footer>

    <button class="back-to-top" type="button" aria-label="Voltar ao topo" title="Voltar ao topo" data-back-to-top>
        <span aria-hidden="true">↑</span>
    </button>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
